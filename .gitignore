.DS_Store
node_modules/
# Per-agent Claude state stays local; the shared session-start hook does not.
# Claude Code on the web reads the hook from the repository, so it has to be
# tracked — hence `.claude/*` plus negations rather than ignoring the directory.
.claude/*
!.claude/hooks/
!.claude/settings.json
.claude/settings.local.json
.env
.env.*
!.env.example
.dev.vars
dist/
.wrangler/
*.log
artifacts/checks/
ac-coverage.json
speed-report.json
playwright-report/
test-results/

# Generated from the served OpenAPI document by cli/generate-api-registry.mjs.
# Not tracked: a committed copy conflicts on every concurrent branch.
cli/api-registry.json

# The sbek eval kit is its own git repo, checked out here for eval runs.
.eval-kit-agent/

# A deploy freeze is per-machine and per-moment, never committed.
.deploy-freeze
