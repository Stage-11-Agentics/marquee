{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    // scripts/seed runs on plain `node` type stripping, so its imports carry
    // the real `.ts` extension the runtime needs.
    "allowImportingTsExtensions": true,
    "lib": ["ES2024"],
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers",
      "@cloudflare/vitest-pool-workers/types",
      "vitest/globals"
    ]
  },
  "include": [
    "tests/**/*.ts",
    "scripts/checks/**/*.mjs",
    "scripts/seed/**/*.ts",
    "vitest.config.ts",
    "vitest.worker.config.ts",
    "vitest.node.config.ts"
  ],
  "exclude": ["tests/e2e/**", "tests/node/**"]
}
