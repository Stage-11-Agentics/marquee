# Note: the plain-HTTP local recipe also needs `--var INSECURE_LOCAL_COOKIES:1`
# on the `wrangler dev` command (see README). It cannot live in this file — the
# build only forwards keys declared in wrangler.jsonc's required-secrets list.

# Cloudflare's published always-pass Turnstile keys for local testing only.
# Never deploy these values to production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# MRQ-14: deterministic fake R2 S3 credentials for local signer tests only.
# Miniflare has no real account S3 endpoint — MRQ-57 supplies production
# values as Wrangler secrets, never committed here.
# R2_ACCOUNT_ID is a secret rather than a var because it identifies the
# Cloudflare account and this repository is public. It reaches the Worker
# through `env` either way.
R2_ACCOUNT_ID=local-fake-account-id
R2_ACCESS_KEY_ID=local-fake-access-key-id
R2_SECRET_ACCESS_KEY=local-fake-secret-access-key
UPLOAD_TOKEN_SECRET=local-fake-upload-token-secret
UPLOAD_RATE_LIMIT_SECRET=local-fake-upload-rate-limit-secret

# Resend delivery truth. Create a webhook for the deployed Worker, then copy
# its whsec_ signing secret here for local verification. Keep this commented
# until you have a real secret; never commit the value.
# RESEND_WEBHOOK_SECRET=whsec_<base64-signing-secret>

# Observability. Both are optional and both have safe defaults; they are listed
# here so the levers docs/OBSERVABILITY.md describes have a visible home.
# LOG_LEVEL: debug | info | warn | error | silent. Default info.
LOG_LEVEL=info
# CLIENT_TELEMETRY: set to 0 and the browser error beacon records nothing,
# enforced at the endpoint rather than trusted to the client. Default on.
CLIENT_TELEMETRY=1
