{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "marquee",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-08",
  "workers_dev": false,

  // Workers Logs, on and unsampled. Every line this Worker emits is one JSON
  // object built from a field allowlist (see src/lib/observability/log.ts), so
  // sampling would only ever hide the one request an organizer is asking about.
  // A conference is not a firehose. To turn logging off entirely, set
  // "enabled": false here — that is the real off switch, and it is documented
  // in docs/OBSERVABILITY.md.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "dev": {
    "local_protocol": "https"
  },
  "routes": [
    {
      "pattern": "marquee.stage11.dev",
      "custom_domain": true
    },
    // MRQ-14: separate media-serving origin (origin isolation — app host
    // must 404 the same /api/v1/media/* path). TODO-OPERATOR (MRQ-57):
    // confirm this custom domain is provisioned before first deploy.
    {
      "pattern": "media.marquee.stage11.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/api/*",
      "/health",
      "/__validation/*",
      "/f/*",
      "/agenda*",
      "/s/*",
      "/p/*",
      "/embed/*",
      "/i/*"
    ],
    "not_found_handling": "single-page-application"
  },

  // TODO-OPERATOR: create the production D1 database and replace both values.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "replace-me-db",
      "database_id": "REPLACE_ME-DB"
    }
  ],

  // TODO-OPERATOR: create the production R2 buckets and replace both names.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "replace-me-media",
      "preview_bucket_name": "replace-me-media-preview"
    }
  ],

  // TODO-OPERATOR: create the production KV namespace and replace the ID.
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "REPLACE_ME-CACHE"
    }
  ],

  // TODO-OPERATOR: create all four production queues and replace every queue name.
  "queues": {
    "producers": [
      { "binding": "MAIL_QUEUE", "queue": "replace-me-mail-queue" },
      { "binding": "MIRROR_QUEUE", "queue": "replace-me-mirror-queue" },
      { "binding": "OPERATIONS_QUEUE", "queue": "replace-me-operations-queue" },
      { "binding": "WEBHOOK_QUEUE", "queue": "replace-me-webhook-queue" }
    ],
    "consumers": [
      { "queue": "replace-me-mail-queue", "max_batch_size": 10 },
      { "queue": "replace-me-mirror-queue", "max_batch_size": 10 },
      { "queue": "replace-me-operations-queue", "max_batch_size": 10 },
      { "queue": "replace-me-webhook-queue", "max_batch_size": 10 }
    ]
  },

  "triggers": {
    "crons": [
      "0 * * * *",   // Hourly pre-close reminder scan.
      "15 4 * * *",  // Daily Airtable webhook keepalive.
      "30 4 * * *"   // Nightly orphaned-upload sweep.
    ]
  },

  // TODO-OPERATOR (MRQ-57): replace with the real account/bucket/media host.
  "vars": {
    "R2_ACCOUNT_ID": "replace-me-account-id",
    "R2_BUCKET_NAME": "replace-me-media",
    "MEDIA_PUBLIC_ORIGIN": "media.marquee.stage11.dev",

    // Observability levers, declared so they are visible rather than folklore.
    // LOG_LEVEL: debug | info | warn | error | silent.
    "LOG_LEVEL": "info",
    // "0" stops the browser error beacon recording anything, enforced at the
    // endpoint rather than trusted to the client. See docs/OBSERVABILITY.md.
    "CLIENT_TELEMETRY": "1"
  },

  // Values come from ignored .dev.vars locally and Wrangler secrets in production.
  "secrets": {
    "required": [
      "TURNSTILE_SITE_KEY",
      "TURNSTILE_SECRET_KEY",
      "RESEND_API_KEY",
      "R2_ACCESS_KEY_ID",
      "R2_SECRET_ACCESS_KEY",
      "UPLOAD_TOKEN_SECRET",
      "UPLOAD_RATE_LIMIT_SECRET"
    ]
  }
}
