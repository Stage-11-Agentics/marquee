{
  "name": "marquee",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "marquee": "cli/marquee.mjs"
  },
  "scripts": {
    "test": "node scripts/checks/run-test.mjs",
    "test:changed": "node scripts/checks/run-test-changed.mjs",
    "seed": "node scripts/seed/index.ts",
    "e2e": "node scripts/checks/run-e2e.mjs",
    "check:r2-cors": "node scripts/checks/check-r2-cors.mjs",
    "check:speed": "node scripts/checks/check-speed.mjs",
    "check:seed": "node scripts/checks/check-seed.mjs",
    "check:api": "node scripts/checks/check-api.mjs",
    "check:repo": "node scripts/checks/check-repo.mjs",
    "check:shell-truth": "node scripts/checks/check-shell-truth.mjs",
    "check:routes": "node scripts/checks/check-routes.mjs",
    "check:clocks": "node scripts/checks/check-clocks.mjs",
    "check:deploy": "node scripts/checks/check-deploy.mjs",
    "check:schema": "node scripts/checks/check-schema.mjs",
    "assemble:public": "node scripts/checks/assemble-public.mjs",
    "check:readme": "node scripts/checks/stub-command.mjs check:readme MRQ-57 \"self-host deploy sequence is not implemented\"",
    "trace:ac": "node scripts/checks/trace-ac.mjs",
    "guard:merge": "bash scripts/checks/portal-merge-guard.sh",
    "check:mirror": "node scripts/checks/stub-command.mjs check:mirror MRQ-25/MRQ-26 \"Airtable mirror and dedicated test base are not implemented\"",
    "reset:demo": "node scripts/reset-demo.mjs",
    "smoke:mail": "node scripts/checks/stub-command.mjs smoke:mail MRQ-24 \"mail delivery and inbox oracle are not implemented\"",
    "smoke:ics": "node scripts/checks/stub-command.mjs smoke:ics MRQ-24 \"calendar delivery and client confirmations are not implemented\"",
    "check:skill-agent": "node scripts/checks/stub-command.mjs check:skill-agent MRQ-44 \"SKILL, CLI, and isolated agent runner are not implemented\"",
    "check:design": "node scripts/checks/verify-design-contract.mjs",
    "pr-gate": "node scripts/checks/pr-gate.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.5.2",
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.1",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.1",
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "^5.20260809.1",
    "@playwright/test": "^1.62.1",
    "@scalar/openapi-parser": "^0.28.12",
    "@types/node": "^26.2.0",
    "happy-dom": "^20.11.2",
    "typescript": "^7.0.2",
    "typescript-ast": "npm:typescript@^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.1"
  }
}
