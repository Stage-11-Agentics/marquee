{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "marquee-inbox",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": false,

  // A fresh localpart is generated by each smoke run. Never replace this
  // catch-all with a reused address: a bounced recipient can be provider-
  // suppressed and make a later oracle report a false negative.
  "addresses": ["*@inbox.marquee.stage11.dev"],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "marquee-inbox",
      // Replace this placeholder with the id returned by `wrangler d1 create`.
      "database_id": "00000000-0000-0000-0000-000000000238",
      "migrations_dir": "./migrations"
    }
  ]
}
