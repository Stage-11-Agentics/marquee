{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://marquee.stage11.dev"
        ],
        "methods": [
          "PUT"
        ],
        "headers": [
          "content-type",
          "if-none-match"
        ]
      },
      "exposeHeaders": [
        "etag"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}
